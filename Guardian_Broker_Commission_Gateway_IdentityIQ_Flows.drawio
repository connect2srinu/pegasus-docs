        <mxCell id="lane_entra" value="Microsoft Entra" style="swimlane;html=1;horizontal=0;startSize=32;fillColor=#EDE9FE;swimlaneFillColor=#FCFAFF;strokeColor=#8B5CF6;fontStyle=1;fontColor=#5B21B6;" vertex="1" parent="1"><mxGeometry x="650" y="105" width="300" height="690" as="geometry"/></mxCell>
        <mxCell id="lane_iiq" value="SailPoint IdentityIQ 8.5" style="swimlane;html=1;horizontal=0;startSize=32;fillColor=#D1FAE5;swimlaneFillColor=#F8FFFB;strokeColor=#10B981;fontStyle=1;fontColor=#065F46;" vertex="1" parent="1"><mxGeometry x="950" y="105" width="300" height="690" as="geometry"/></mxCell>
        <mxCell id="lane_aws" value="AWS AgentCore" style="swimlane;html=1;horizontal=0;startSize=32;fillColor=#FEF3C7;swimlaneFillColor=#FFFCF5;strokeColor=#F59E0B;fontStyle=1;fontColor=#92400E;" vertex="1" parent="1"><mxGeometry x="1250" y="105" width="300" height="690" as="geometry"/></mxCell>

        <mxCell id="s1" value="1. Request Broker Commission Gateway" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6B7280;fontSize=13;" vertex="1" parent="1"><mxGeometry x="75" y="155" width="220" height="60" as="geometry"/></mxCell>
        <mxCell id="s2" value="2. Validate platform authorization and create setup workflow" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#2563EB;fontSize=13;" vertex="1" parent="1"><mxGeometry x="375" y="155" width="230" height="60" as="geometry"/></mxCell>
        <mxCell id="s3" value="3. Create Broker Commission app registration and Enterprise Application" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F3FF;strokeColor=#7C3AED;fontSize=13;" vertex="1" parent="1"><mxGeometry x="690" y="245" width="220" height="70" as="geometry"/></mxCell>
        <mxCell id="s4" value="4. Create Broker Commission security group" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F3FF;strokeColor=#7C3AED;fontSize=13;" vertex="1" parent="1"><mxGeometry x="690" y="345" width="220" height="60" as="geometry"/></mxCell>
        <mxCell id="s5" value="5. Assign security group to Enterprise Application and configure API scope/app role" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F3FF;strokeColor=#7C3AED;fontSize=13;" vertex="1" parent="1"><mxGeometry x="690" y="435" width="220" height="75" as="geometry"/></mxCell>
        <mxCell id="s6" value="6. Create AgentCore Gateway with Entra JWT authorizer&#xa;• OIDC discovery URL&#xa;• allowed audience/scope" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFBEB;strokeColor=#D97706;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1290" y="435" width="220" height="90" as="geometry"/></mxCell>
        <mxCell id="s7" value="7. Submit/register entitlement metadata&#xa;Entra group ID • display name • owner • approval profile" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#059669;fontSize=13;" vertex="1" parent="1"><mxGeometry x="990" y="555" width="220" height="90" as="geometry"/></mxCell>
        <mxCell id="s8" value="8. Correlate Entra group through source aggregation; create/configure requestable profile or role" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#059669;fontSize=13;" vertex="1" parent="1"><mxGeometry x="990" y="675" width="220" height="85" as="geometry"/></mxCell>
        <mxCell id="s9" value="9. Store mappings and mark setup READY&#xa;Gateway ARN ↔ App ID ↔ Group ID ↔ IdentityIQ access-item ID" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#2563EB;fontSize=13;" vertex="1" parent="1"><mxGeometry x="375" y="675" width="230" height="85" as="geometry"/></mxCell>
        <mxCell id="note1" value="Important: creating a record alone does not create an IdentityIQ entitlement. The Entra group must be discovered/correlated by the configured source before the profile or role becomes requestable." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;fillColor=#FFF7ED;strokeColor=#F97316;fontColor=#9A3412;fontSize=12;" vertex="1" parent="1"><mxGeometry x="985" y="155" width="235" height="120" as="geometry"/></mxCell>

