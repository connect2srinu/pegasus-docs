        <mxCell id="review" value="&lt;b&gt;Governance evidence and remaining decisions&lt;/b&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FAFBFC;strokeColor=#AFBFCD;strokeWidth=1.5;fontColor=#21364D;fontFamily=DejaVu Sans;fontSize=22;spacing=12;align=center;verticalAlign=middle;rounded=0;align=left;verticalAlign=top;spacingTop=12;container=1;collapsible=0;recursiveResize=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="1510" width="2320" height="290" />
        </mxCell>
        <mxCell id="review-text" value="Review the complete pattern and versioned provisioning / infrastructure code; deployments must conform to approved templates and configuration boundaries.&lt;br&gt;Security owns environment-specific Entra apps, secrets and AWS credential providers. Control Plane uses their supplied references.&lt;br&gt;Future execution-account services: AgentCore Browser, Code Interpreter, Memory and Evaluations; review each within the complete supported pattern.&lt;br&gt;Inference Gateway is part of the Control Plane API in Account A; Guardian apps in C and Claude Code in D call it with API keys, then it invokes Account A Bedrock.&lt;br&gt;Remaining decisions: EKS and Harness hosting, ingress and private routes, database engine / HA, service execution permissions and ADOT deployment / export policy.&lt;br&gt;AWS shape library: native draw.io AWS4 components. ADOT reference: https://aws-otel.github.io/docs/components/processors/" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#53677C;fontFamily=DejaVu Sans;fontSize=17;spacing=12;align=center;verticalAlign=middle;rounded=0;align=left;spacing=0;" vertex="1" parent="review">
          <mxGeometry as="geometry" x="30" y="60" width="2250" height="175" />
        </mxCell>
