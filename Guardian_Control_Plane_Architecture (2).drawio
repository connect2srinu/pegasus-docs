        </mxCell>
        <mxCell id="onboarding" value="&lt;b&gt;Execution-plane registration contract&lt;/b&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F2F7FC;strokeColor=#2374AB;strokeWidth=1.5;fontColor=#21364D;fontFamily=DejaVu Sans;fontSize=22;spacing=12;align=center;verticalAlign=middle;rounded=0;align=left;verticalAlign=top;spacingTop=12;container=1;collapsible=0;recursiveResize=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="1410" width="2320" height="225" />
        </mxCell>
        <mxCell id="onboarding-text" value="1. Security prepares the two Entra apps and corresponding AWS credential providers for the selected environment.&lt;br&gt;2. The platform team registers the environment under the organization and connects its dedicated AWS execution account.&lt;br&gt;3. Control Plane stores account / environment metadata and credential-provider references; secret-value handling follows the approved security design.&lt;br&gt;4. ControlPlane-App assumes the appropriate account-specific role to provision resources or invoke an agent / Toolkit.&lt;br&gt;Control Plane user SSO remains a separate identity concern from the environment-specific Agent and Gateway Tools app pairs." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#53677C;fontFamily=DejaVu Sans;fontSize=18;spacing=12;align=center;verticalAlign=middle;rounded=0;align=left;spacing=0;" vertex="1" parent="onboarding">
          <mxGeometry as="geometry" x="30" y="60" width="2260" height="130" />
        </mxCell>
        <mxCell id="supply-providers" style="edgeStyle=segmentEdgeStyle;rounded=0;html=1;strokeColor=#7B4AB0;strokeWidth=2;endArrow=block;endFill=1;jumpStyle=arc;jumpSize=8;exitX=0.0;exitY=0.5;exitDx=0;exitDy=0;entryX=1.0;entryY=0.5;entryDx=0;entryDy=0;exitPerimeter=0;entryPerimeter=0;" edge="1" parent="1" source="security" target="register">
          <mxGeometry as="geometry" relative="1" />
