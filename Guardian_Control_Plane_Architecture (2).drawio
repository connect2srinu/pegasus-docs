          <mxGeometry as="geometry" x="40" y="1280" width="2320" height="270" />
        </mxCell>
        <mxCell id="routing-notes-text" value="• Inference Gateway is an endpoint of the Control Plane API in Account A, built from the API Git repository.&lt;br&gt;• Guardian apps (Account C) and Claude Code (Account D) authenticate to this endpoint with API keys.&lt;br&gt;• The shared endpoint calls Bedrock in Account A, including Claude models available through Bedrock.&lt;br&gt;• Harness agents invoke Bedrock directly in their own Account B execution environment in this version.&lt;br&gt;• Existing Entra app/provider pairs, Control Plane invocation roles and Harness → ADOT → Arize telemetry are unchanged.&lt;br&gt;• Private connectivity, ingress routing and Bedrock invocation permissions still need implementation-level validation." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#53677C;fontFamily=DejaVu Sans;fontSize=19;spacing=12;align=center;verticalAlign=middle;rounded=0;align=left;spacing=0;" vertex="1" parent="routing-notes">
