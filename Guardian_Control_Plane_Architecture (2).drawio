        <mxCell id="key" value="&lt;b&gt;Reading the diagram&lt;/b&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FAFBFC;strokeColor=#BCC7D1;strokeWidth=1.5;fontColor=#21364D;fontFamily=DejaVu Sans;fontSize=20;spacing=12;align=center;verticalAlign=middle;rounded=0;align=left;verticalAlign=top;spacingTop=12;container=1;collapsible=0;recursiveResize=0;" vertex="1" parent="1">
